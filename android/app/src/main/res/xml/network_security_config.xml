<?xml version="1.0" encoding="utf-8"?>
<!-- Houston runs on your Apollo at an address you choose (home IP, Tailscale name). At home it uses plain
     http, like the Apollo dashboard, so the app allows that. Use Houston's https address where you can. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
