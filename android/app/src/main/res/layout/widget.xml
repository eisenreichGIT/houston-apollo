<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="₿ –"
            android:textColor="#F7931A"
            android:textSize="26sp"
            android:textStyle="bold"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9A968B"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:paddingEnd="8dp" />
        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/w_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/dot"
            android:contentDescription="Status" />
        <TextView
            android:id="@+id/w_hash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:text="–"
            android:textColor="#EEEAE0"
            android:textSize="30sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:text="TH/s"
            android:textColor="#9A968B"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/w_mode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="#EEEAE0"
            android:textSize="15sp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9A968B"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:text="Tap to open Houston" />
</LinearLayout>
